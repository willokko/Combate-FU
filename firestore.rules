rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/sync/head {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['version', 'generation', 'chunkCount', 'updatedAt', 'previousGeneration', 'previousChunkCount'])
        && request.resource.data.version == 1
        && request.resource.data.generation is string
        && request.resource.data.generation.matches('^[a-zA-Z0-9-]{1,80}$')
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount >= 1 && request.resource.data.chunkCount <= 32
        && request.resource.data.updatedAt == request.time
        && request.resource.data.previousGeneration is string
        && request.resource.data.previousGeneration.matches('^[a-zA-Z0-9-]{0,80}$')
        && request.resource.data.previousChunkCount is int
        && request.resource.data.previousChunkCount >= 0 && request.resource.data.previousChunkCount <= 32;
    }
    match /users/{uid}/snapshots/{generation}/chunks/{index} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid)
        && generation.matches('^[a-zA-Z0-9-]{1,80}$')
        && index.matches('^[0-9]{1,2}$')
        && request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 720000;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
