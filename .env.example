# Padrão: aplicação totalmente local. Nenhuma credencial é necessária.
VITE_DATA_MODE=local
VITE_BASE_PATH=/

# Opcional, em uma instalação remota separada: use seu próprio projeto Firebase.
# VITE_DATA_MODE=remote
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# Catálogo compartilhado de recursos (opcional): URL e chave PÚBLICA, com RLS.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_KEY=
# Nunca use service_role, contas de serviço, senhas ou webhooks secretos em VITE_*.
